{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Shortcut Explorer",
      "type": "debugpy",
      "request": "launch",
      "module": "kde_shortcuts.app",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    }
  ]
}
