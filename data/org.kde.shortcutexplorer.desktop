[Desktop Entry]
Type=Application
Name=Plasma Shortcut Explorer
Comment=Search your configured KDE global shortcuts
Exec=plasma-shortcut-explorer
Icon=org.kde.shortcutexplorer
Terminal=false
Categories=Utility;Qt;KDE;
Keywords=shortcuts;keybind;keybindings;hotkeys;keyboard;
StartupNotify=true
StartupWMClass=org.kde.shortcutexplorer

Actions=Settings;

[Desktop Action Settings]
Name=Settings
Exec=plasma-shortcut-explorer --settings
